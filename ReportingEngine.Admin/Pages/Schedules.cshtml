@page
@model ReportingEngine.Admin.Pages.SchedulesModel
<h1>Schedules</h1>
<div id="msg"></div>
<div class="panel">
  <div class="grid-2">
    <div><label>Name</label><input id="sName" /></div>
    <div><label>Type</label><select id="sType"><option>CRON</option><option>DAILY</option><option>WEEKLY</option><option>MONTHLY</option><option>ONCE</option></select></div>
    <div><label>CronExpression</label><input id="sCron" value="0 * * * *" /></div>
    <div><label>TimeZoneId</label><input id="sTz" value="UTC" /></div>
  </div>
  <button onclick="createSchedule()">Create</button>
</div>
<div class="panel"><table><thead><tr><th>Id</th><th>Name</th><th>Type</th><th>Cron</th><th>TZ</th><th>Active</th></tr></thead><tbody id="rows"></tbody></table></div>
@section Scripts {
<script>
async function load(){ const items=await api.get('/api/schedules'); rows.innerHTML=items.map(x=>`<tr><td>${x.scheduleId}</td><td>${x.scheduleName}</td><td>${x.scheduleType}</td><td>${x.cronExpression||''}</td><td>${x.timeZoneId}</td><td>${x.isActive}</td></tr>`).join(''); }
async function createSchedule(){ try{ await api.send('/api/schedules','POST',{scheduleName:sName.value,scheduleType:sType.value,cronExpression:sCron.value,timeZoneId:sTz.value,startDate:null,endDate:null}); showMsg(msg,'Created',true); await load(); } catch(e){ showMsg(msg,e.message,false);} }
load();
</script>
}
