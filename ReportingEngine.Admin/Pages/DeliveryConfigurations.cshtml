@page
@model ReportingEngine.Admin.Pages.DeliveryConfigurationsModel
<h1>Delivery Profiles</h1>
<div id="msg"></div>

<div class="panel">
  <h3 id="formTitle">Create / Edit Delivery Profile</h3>
  <div class="grid-2">
    <div><label>ID</label><input id="dId" readonly style="background:#f3f4f6;" /></div>
    <div><label>Profile Name</label><input id="dName" placeholder="e.g. Customer Report Email" /></div>
    <div><label>Delivery Type</label>
      <select id="dType" onchange="toggleTypeFields()">
        <option value="EMAIL">EMAIL</option>
        <option value="AZURE_FILE_SHARE">AZURE_FILE_SHARE</option>
        <option value="S3">S3</option>
        <option value="SFTP">SFTP</option>
        <option value="SHARED_FOLDER">SHARED_FOLDER</option>
        <option value="FTP">FTP</option>
        <option value="BLOB">BLOB</option>
      </select>
    </div>
    <div><label>Status</label><select id="dActive"><option value="true">Active</option><option value="false">Inactive</option></select></div>
    <div class="emailField"><label>SMTP Profile</label><select id="dSmtpConfigId"></select></div>
    <div class="emailField"><label>To Email(s)</label><input id="dTo" placeholder="comma separated emails" /></div>
    <div class="emailField"><label>CC Email(s)</label><input id="dCc" /></div>
    <div class="emailField"><label>BCC Email(s)</label><input id="dBcc" /></div>
    <div class="emailField"><label>Subject Template</label><input id="dSubject" value="Report {ReportCode} - {ExecutionDate}" /></div>
    <div class="emailField"><label>Body Template (HTML)</label><input id="dBody" value="<p>Customer {CustomerCode}: {RecordCount} records generated in {FileCount} file(s).</p>" /></div>
    <div id="destRefGroup"><label>Destination / Path Reference</label><input id="dDest" /></div>
    <div id="secretRefGroup"><label>Secret / Connection Reference</label><input id="dSecret" /></div>
    <div class="azureField"><label>Azure Storage Connection String</label><input id="azConnection" type="password" /></div>
    <div class="azureField"><label>Azure File Share Name</label><input id="azShare" placeholder="childfolder" /></div>
    <div class="azureField"><label>Azure Directory Path</label><input id="azPath" /></div>
    <div class="s3Field"><label>S3 Access Key ID</label><input id="s3AccessKey" /></div>
    <div class="s3Field"><label>S3 Secret Access Key</label><input id="s3SecretKey" type="password" /></div>
    <div class="s3Field"><label>S3 Region</label><input id="s3Region" value="us-east-1" /></div>
    <div class="s3Field"><label>S3 Bucket Name</label><input id="s3Bucket" /></div>
    <div class="s3Field"><label>S3 Folder / Prefix</label><input id="s3Prefix" /></div>
    <div class="s3Field"><label>S3 Service URL</label><input id="s3ServiceUrl" /></div>
    <div class="s3Field"><label>Force Path Style</label><select id="s3ForcePath"><option value="false">false</option><option value="true">true</option></select></div>
  </div>
  <div style="margin-top:0.75rem;">
    <button onclick="createDelivery()">Create</button>
    <button class="secondary" onclick="updateDelivery()">Update</button>
    <button class="secondary" onclick="testSelectedDelivery()">Test Selected</button>
    <button class="secondary" onclick="resetForm()">Clear</button>
    <button class="secondary" onclick="testSftpConnection()" id="btnTestSftp" style="display:none;">Test SFTP</button>
  </div>
</div>

<div class="panel">
  <h3>Delivery Profiles</h3>
  <table>
    <thead><tr><th>Id</th><th>Name</th><th>Type</th><th>Target</th><th>Connection</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody id="rows"></tbody>
  </table>
</div>

@section Scripts {
<script>
function escapeHtml(value) { return String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function tryParseJson(value) { if (!value || !value.trim().startsWith('{')) return {}; try { return JSON.parse(value); } catch { return {}; } }
function buildAzureSecret() { return JSON.stringify({ ConnectionString: azConnection.value, ShareName: azShare.value, DirectoryPath: azPath.value || '' }); }
function buildS3Secret() {
  return JSON.stringify({ AccessKeyId: s3AccessKey.value || null, SecretAccessKey: s3SecretKey.value || null, Region: s3Region.value || 'us-east-1', BucketName: s3Bucket.value, Prefix: s3Prefix.value || '', ServiceUrl: s3ServiceUrl.value || null, ForcePathStyle: s3ForcePath.value === 'true' });
}
function request(includeActive) {
  const type = dType.value;
  const body = {
    deliveryName: dName.value, deliveryType: type, destinationReference: dDest.value || null,
    emailTo: type === 'EMAIL' ? dTo.value : null, emailCc: type === 'EMAIL' ? (dCc.value || null) : null,
    emailBcc: type === 'EMAIL' ? (dBcc.value || null) : null,
    emailSubjectTemplate: type === 'EMAIL' ? dSubject.value : null, emailBodyTemplate: type === 'EMAIL' ? dBody.value : null,
    secretReference: dSecret.value || null, smtpConfigId: type === 'EMAIL' ? Number(dSmtpConfigId.value || 0) : null, isFailureNotification: false
  };
  if (type === 'AZURE_FILE_SHARE') { body.destinationReference = azPath.value || null; body.secretReference = buildAzureSecret(); }
  if (type === 'S3') { body.destinationReference = s3Prefix.value || null; body.secretReference = buildS3Secret(); }
  if (includeActive) body.isActive = dActive.value === 'true';
  return body;
}
function toggleTypeFields() {
  const type = dType.value, isEmail = type === 'EMAIL', isAzure = type === 'AZURE_FILE_SHARE', isS3 = type === 'S3';
  document.querySelectorAll('.emailField').forEach(x => x.style.display = isEmail ? 'block' : 'none');
  document.querySelectorAll('.azureField').forEach(x => x.style.display = isAzure ? 'block' : 'none');
  document.querySelectorAll('.s3Field').forEach(x => x.style.display = isS3 ? 'block' : 'none');
  destRefGroup.style.display = (!isEmail && !isAzure && !isS3) ? 'block' : 'none';
  secretRefGroup.style.display = (!isEmail && !isAzure && !isS3) ? 'block' : 'none';
  btnTestSftp.style.display = type === 'SFTP' ? 'inline-block' : 'none';
}
async function loadSmtpProfiles() {
  const profiles = await api.get('/api/smtpconfigurations');
  dSmtpConfigId.innerHTML = '<option value="">Select SMTP Profile</option>' + profiles.filter(x => x.isActive).map(x => `<option value="${x.smtpConfigId}">${escapeHtml(x.profileName)}</option>`).join('');
}
function describeConnection(x) {
  const secret = tryParseJson(x.secretReference);
  if (x.deliveryType === 'EMAIL') return x.smtpProfileName ? `SMTP: ${escapeHtml(x.smtpProfileName)}` : '<span style="color:var(--danger)">SMTP missing</span>';
  if (x.deliveryType === 'AZURE_FILE_SHARE') return `Share: ${escapeHtml(secret.ShareName || '-')}`;
  if (x.deliveryType === 'S3') return `Bucket: ${escapeHtml(secret.BucketName || '-')}`;
  return x.secretReference ? '<span style="color:var(--muted);">Configured</span>' : '(none)';
}
async function testSftpConnection() {
  try { const res = await api.send('/api/deliveryconfigurations/test-sftp', 'POST', { destinationReference: dDest.value, secretReference: dSecret.value }); showMsg(msg, res.message || 'SFTP connection test successful.', true); }
  catch(e) { showMsg(msg, 'SFTP Test Failed: ' + e.message, false); }
}
async function load() {
  await loadSmtpProfiles();
  const items = await api.get('/api/deliveryconfigurations');
  rows.innerHTML = items.map(x => {
    const secret = tryParseJson(x.secretReference);
    const target = x.deliveryType === 'EMAIL' ? 'Email: ' + escapeHtml(x.emailTo || '-') : x.deliveryType === 'AZURE_FILE_SHARE' ? escapeHtml(secret.DirectoryPath || x.destinationReference || 'Share root') : x.deliveryType === 'S3' ? escapeHtml(secret.Prefix || x.destinationReference || 'Bucket root') : escapeHtml(x.destinationReference || '-');
    return `<tr><td><strong>${x.deliveryConfigId}</strong></td><td><strong>${escapeHtml(x.deliveryName)}</strong></td><td><span class="badge">${escapeHtml(x.deliveryType)}</span></td><td>${target}</td><td>${describeConnection(x)}</td><td>${x.isActive ? '<span style="color:var(--ok)">Active</span>' : 'Inactive'}</td><td><button class="secondary" onclick="editDelivery(${x.deliveryConfigId})">Edit</button> <button class="secondary" onclick="testDelivery(${x.deliveryConfigId}, '${escapeHtml(x.deliveryType).replace(/'/g, "\\'")}')">Test</button> <button class="danger" onclick="deleteDelivery(${x.deliveryConfigId}, '${escapeHtml(x.deliveryName).replace(/'/g, "\\'")}')">Delete</button></td></tr>`;
  }).join('');
}
async function createDelivery() { try { await api.send('/api/deliveryconfigurations', 'POST', request(false)); showMsg(msg, 'Delivery profile created.', true); resetForm(); await load(); } catch(e) { showMsg(msg, e.message, false); } }
async function updateDelivery() { try { if (!dId.value) throw new Error('Please select a delivery profile first.'); await api.send('/api/deliveryconfigurations/' + dId.value, 'PUT', request(true)); showMsg(msg, 'Delivery profile updated.', true); resetForm(); await load(); } catch(e) { showMsg(msg, e.message, false); } }
async function editDelivery(id) {
  const x = await api.get('/api/deliveryconfigurations/' + id);
  dId.value = x.deliveryConfigId; dName.value = x.deliveryName || ''; dType.value = x.deliveryType || 'EMAIL'; dActive.value = x.isActive ? 'true' : 'false';
  dDest.value = x.destinationReference || ''; dSecret.value = x.secretReference || ''; dTo.value = x.emailTo || ''; dCc.value = x.emailCc || ''; dBcc.value = x.emailBcc || ''; dSmtpConfigId.value = x.smtpConfigId || '';
  dSubject.value = x.emailSubjectTemplate || 'Report {ReportCode} - {ExecutionDate}'; dBody.value = x.emailBodyTemplate || '<p>Customer {CustomerCode}: {RecordCount} records generated in {FileCount} file(s).</p>';
  const secret = tryParseJson(x.secretReference);
  azConnection.value = secret.ConnectionString || ''; azShare.value = secret.ShareName || ''; azPath.value = secret.DirectoryPath || x.destinationReference || '';
  s3AccessKey.value = secret.AccessKeyId || secret.AccessKey || ''; s3SecretKey.value = secret.SecretAccessKey || secret.SecretKey || ''; s3Region.value = secret.Region || 'us-east-1'; s3Bucket.value = secret.BucketName || secret.Bucket || ''; s3Prefix.value = secret.Prefix || secret.Path || x.destinationReference || ''; s3ServiceUrl.value = secret.ServiceUrl || secret.ServiceURL || ''; s3ForcePath.value = secret.ForcePathStyle === true ? 'true' : 'false';
  toggleTypeFields(); formTitle.innerText = `Edit Delivery Profile #${x.deliveryConfigId}`; window.scrollTo({ top: 0, behavior: 'smooth' });
}
async function deleteDelivery(id, label) { if (!confirm(`Delete delivery profile "${label}"?`)) return; try { await api.send('/api/deliveryconfigurations/' + id, 'DELETE'); showMsg(msg, 'Delivery profile deleted.', true); resetForm(); await load(); } catch(e) { showMsg(msg, e.message, false); } }
async function testDelivery(id, type) {
  let recipientEmail = null;
  if (type === 'EMAIL') {
    recipientEmail = prompt('Send test email with dummy attachment to:', dTo.value || '');
    if (recipientEmail === null) return;
  }
  try { const res = await api.send('/api/deliveryconfigurations/' + id + '/test', 'POST', { recipientEmail }); showMsg(msg, res.message || 'Delivery test succeeded.', true); }
  catch(e) { showMsg(msg, e.message, false); }
}
async function testSelectedDelivery() {
  if (!dId.value) { showMsg(msg, 'Please select a delivery profile first.', false); return; }
  await testDelivery(dId.value, dType.value);
}
function resetForm() {
  dId.value = ''; dName.value = ''; dType.value = 'EMAIL'; dActive.value = 'true'; dDest.value = ''; dSecret.value = ''; dSmtpConfigId.value = ''; dTo.value = ''; dCc.value = ''; dBcc.value = ''; dSubject.value = 'Report {ReportCode} - {ExecutionDate}'; dBody.value = '<p>Customer {CustomerCode}: {RecordCount} records generated in {FileCount} file(s).</p>';
  azConnection.value = ''; azShare.value = ''; azPath.value = ''; s3AccessKey.value = ''; s3SecretKey.value = ''; s3Region.value = 'us-east-1'; s3Bucket.value = ''; s3Prefix.value = ''; s3ServiceUrl.value = ''; s3ForcePath.value = 'false'; formTitle.innerText = 'Create / Edit Delivery Profile'; toggleTypeFields();
}
toggleTypeFields();
load();
</script>
}
