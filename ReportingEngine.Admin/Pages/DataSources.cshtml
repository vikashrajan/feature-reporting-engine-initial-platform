@page
@model ReportingEngine.Admin.Pages.DataSourcesModel
<h1>Data Sources</h1>
<div id="msg"></div>
<div class="panel">
  <h3 id="formTitle">Create / Edit Data Source</h3>
  <div class="grid-2">
    <div><label>Data Source ID (auto for Edit)</label><input id="dsId" readonly style="background:#f3f4f6;" /></div>
    <div><label>Name</label><input id="dsName" /></div>
    <div><label>Type</label><select id="dsType"><option>SQL</option><option>COSMOS</option><option>POSTGRES</option><option>ORACLE</option><option>API</option></select></div>
    <div><label>Connection Reference</label><input id="dsRef" value="SampleSql" /></div>
    <div><label>Source DB Connection String</label><textarea id="dsConn" rows="3" placeholder="Server=...;Database=...;"></textarea></div>
    <div><label>Status</label><select id="dsActive"><option value="true">Active</option><option value="false">Inactive</option></select></div>
  </div>
  <div style="margin-top:0.75rem;">
    <button onclick="createDs()">Create Data Source</button>
    <button class="secondary" onclick="updateDs()">Update Data Source</button>
    <button class="secondary" onclick="resetForm()">Clear / New</button>
  </div>
</div>
<div class="panel"><table><thead><tr><th>Id</th><th>Name</th><th>Type</th><th>Reference</th><th>Connection</th><th>Active</th><th>Actions</th></tr></thead><tbody id="rows"></tbody></table></div>
@section Scripts {
<script>
async function load(){ const items=await api.get('/api/datasources'); rows.innerHTML=items.map(x=>`<tr><td><strong>#${x.dataSourceId}</strong></td><td><strong>${x.dataSourceName}</strong></td><td>${x.dataSourceType}</td><td><code>${x.connectionReference}</code></td><td>${x.hasConfiguredConnection ? 'Configured' : 'Missing'}</td><td>${x.isActive ? 'Active' : 'Inactive'}</td><td><button class="secondary" onclick="editDs(${x.dataSourceId})">Edit</button> <button class="danger" onclick="deleteDs(${x.dataSourceId}, '${x.dataSourceName.replace(/'/g, "\\'")}')">Delete</button></td></tr>`).join(''); }
function requestBody(){ return {dataSourceName:dsName.value,dataSourceType:dsType.value,connectionReference:dsRef.value,connectionString:dsConn.value || null}; }
async function createDs(){ try{ await api.send('/api/datasources','POST',requestBody()); showMsg(msg,'Created',true); resetForm(); await load(); } catch(e){ showMsg(msg,e.message,false);} }
async function updateDs(){ try{ if(!dsId.value) throw new Error('Select a data source to edit first.'); const body=requestBody(); body.isActive=dsActive.value==='true'; await api.send('/api/datasources/'+dsId.value,'PUT',body); showMsg(msg,'Updated',true); resetForm(); await load(); } catch(e){ showMsg(msg,e.message,false);} }
async function editDs(id){ const x=await api.get('/api/datasources/'+id); dsId.value=x.dataSourceId; dsName.value=x.dataSourceName; dsType.value=x.dataSourceType; dsRef.value=x.connectionReference; dsConn.value=''; dsActive.value=x.isActive?'true':'false'; formTitle.innerText='Edit Data Source #'+x.dataSourceId; window.scrollTo({top:0,behavior:'smooth'}); }
async function deleteDs(id,label){ if(!confirm(`Delete data source "${label}"?`)) return; try{ await api.send('/api/datasources/'+id,'DELETE'); showMsg(msg,'Deleted',true); resetForm(); await load(); } catch(e){ showMsg(msg,e.message,false);} }
function resetForm(){ dsId.value=''; dsName.value=''; dsType.value='SQL'; dsRef.value='SampleSql'; dsConn.value=''; dsActive.value='true'; formTitle.innerText='Create / Edit Data Source'; }
load();
</script>
}
