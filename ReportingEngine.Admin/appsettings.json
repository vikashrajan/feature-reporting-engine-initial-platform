{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Server=(localdb)\\mssqllocaldb;Database=ReportingEngine;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Hangfire": {
    "WorkerCount": 5,
    "SchemaName": "HangFire",
    "DashboardEnabled": true,
    "DashboardPath": "/hangfire"
  },
  "Retry": {
    "MaxRetryCount": 3,
    "InitialDelaySeconds": 30,
    "BackoffMultiplier": 2.0
  },
  "Execution": {
    "CommandTimeoutSeconds": 120,
    "TemporaryFilePath": "./temp-reports"
  },
  "Email": {
    "Host": "localhost",
    "Port": 25,
    "EnableSsl": false,
    "FromAddress": "noreply@reportingengine.local",
    "FromDisplayName": "ReportingEngine",
    "UserName": null,
    "Password": null,
    "SmtpTimeoutSeconds": 120,
    "UseFileDrop": true,
    "FileDropPath": "./temp-emails",
    "FailureNotificationEnabled": false,
    "FailureNotificationTo": null,
    "FailureNotificationCc": null,
    "FailureNotificationSubjectTemplate": "ReportingEngine job failed: {ReportCode}",
    "FailureNotificationBodyTemplate": "<p>Report {ReportCode} failed.</p><p>Execution: {ExecutionId}</p><p>Status: {Status}</p><p>Error: {ErrorMessage}</p>"
  },
  "ConnectionReferences": {
    "Values": {
      "SampleSql": "Server=(localdb)\\mssqllocaldb;Database=ReportingEngine;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
    }
  },
  "SecretReferences": {
    "Values": {}
  },
  "Seed": {
    "Enabled": true
  }
}
